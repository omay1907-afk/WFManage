# ------------------------------------------------------------------
# 01_mysql_module.cli
#
# Installiert den MySQL-JDBC-Treiber (mysql-connector-j) als JBoss-Modul.
#
# VORAUSSETZUNG: Die Treiber-JAR muss vorher heruntergeladen werden
# (z. B. von https://dev.mysql.com/downloads/connector/j/ oder Maven
# Central, Koordinaten: com.mysql:mysql-connector-j:8.4.0) und lokal
# auf dem Rechner liegen, von dem aus Sie die CLI ausführen.
#
# Aufruf:
#   EAP_HOME/bin/jboss-cli.sh --connect --file=01_mysql_module.cli
#
# Den Pfad zur JAR unten bei --resources anpassen.
#
# HINWEIS: "jakarta.api" wurde als Abhängigkeit entfernt - dieses
# Modul existiert unter diesem Namen nicht in WildFly/EAP 8.1 und
# führte zu "Module ... is missing: [jakarta.api]" beim Laden des
# Treibers. jakarta.transaction.api (für XA-Unterstützung) reicht aus
# und wurde bereits erfolgreich aufgelöst.
# ------------------------------------------------------------------

module add --name=com.mysql --resources=/pfad/zu/mysql-connector-j-8.4.0.jar --dependencies=jakarta.transaction.api
